# ---- core
APP_ENV=production                 # development | production
SECRET_KEY=change-me-to-a-long-random-string
PUBLIC_BASE_URL=https://www.cleanmystreet.co.za
# DATABASE_PATH=/var/data/cleanmystreet.sqlite3   # put on a persistent disk
# UPLOAD_FOLDER=/var/data/uploads                 # if you change this, serve it at /static/uploads

# ---- payments (Yoco)
PAYMENT_MODE=yoco                  # yoco | demo   (demo is blocked in production)
YOCO_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx   # sk_live_ for real money
YOCO_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx  # printed by: flask --app wsgi register-webhook https://<domain>/webhooks/yoco

# ---- daily job that closes expired projects and issues refunds
CRON_SECRET=another-long-random-string

# ---- email (optional; without it emails are written to the log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Clean My Street <info@cleanmystreet.co.za>
MAIL_REPLY_TO=info@cleanmystreet.co.za
ADMIN_NOTIFY_EMAIL=info@cleanmystreet.co.za
